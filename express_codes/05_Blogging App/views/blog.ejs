<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("./partials/head") %>
    <title>Blog</title>
  </head>
  <body>
    <%- include("./partials/nav") %>

    <div class="container mt-4">
      <h1 class="mt-3"><%= blog.title %></h1>
      <img class="mt-3" src="<%= blog.coverImageURL %>" width="50%" />
      <pre class="mt-3"><%= blog.body %></pre>
    </div>

    <div class="container mt-4">
      <img src="<%= blog.createdBy.profileImageURL %>" width="20%" />
      <span> Posted by <%= blog.createdBy.fullName %></span>
    </div>

    <div class="container mt-3">
      <h1>Comments</h1>
      <% if(locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="POST">
        <div class="mb-3">
          <input
            type="text"
            name="content"
            class="form-control"
            placeholder="Enter Comment"
          />
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
      </form>
      <% } %>
    </div>

    <div class="container mt-3">
    <% if(locals.comments) { %>
      <% comments.forEach(comment => { %>
        <div> 
        <img src="<%= comment.createdBy.profileImageURL %>" width="2%" />
      <%= comment.createdBy.fullName %>
      <pre><%= comment.content %></pre>
    </div>
      <% }); } %>
    </div>
 
    <%- include("./partials/scripts") %>
  </body>
</html>
